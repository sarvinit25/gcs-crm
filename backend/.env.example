DATABASE_URL="postgresql://gcs:gcs@localhost:5433/gcs_crm?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
# Production only (required there): openssl rand -hex 32. Without it dev derives a key from JWT_SECRET.
# SECRETS_ENCRYPTION_KEY=""
PORT=4000
# Served behind Nginx at https://growthcapitalservices.in/crm
API_PREFIX="/crm/api"
# Origins allowed to call the API from a browser: this app in dev, and the public website
# (its lead form and the pop-up poster call the public endpoints).
CORS_ORIGIN="http://localhost:5173,http://localhost:8080"
# Number of proxy hops in front of the app (1 when Nginx fronts it).
# Leave 0 in local dev, or rate limiting reads every request as one IP.
TRUST_PROXY_HOPS=0
# Cloudflare Turnstile — protects the public lead intake.
# Required in production; without it the app refuses to boot.
TURNSTILE_SECRET=""
# Backblaze B2 (S3-compatible) — document storage
B2_ENDPOINT=""
B2_REGION=""
B2_BUCKET=""
B2_KEY_ID=""
B2_APP_KEY=""

# Outgoing email (new-enquiry alerts, the customer thank-you and chat sign-in codes), all through Zoho Mail's API.
# The same values as the website's Cloudflare secrets. Leave any empty to keep email off.
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ACCOUNT_ID=""
# The mailbox the refresh token belongs to.
ZOHO_FROM_ADDRESS=""
# "in" (default) or "com", to match the Zoho account.
ZOHO_REGION="in"
# Where the logo in emails is loaded from.
WEBSITE_URL="https://gcs-website.jonathannnn3009.workers.dev"

# Website chat sign-in: a one-time code is texted to the visitor before the chat opens.
# Without a provider, development prints the code in the server log; production cannot send codes.
# SMS_PROVIDER="msg91"
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""   # an OTP template approved on DLT, with the ##OTP## variable
# Testing before SMS is set up (works in production too): these numbers skip the SMS and always accept
# this 6-digit code. Real numbers are not affected. Remove both once MSG91 is working.
# CHAT_OTP_TEST_PHONES="9000000001,9000000002"
# CHAT_OTP_TEST_CODE="246810"

# The "Ask AI" chat inside the CRM (read-only questions about clients and the data). It uses the same OpenAI settings as the
# website chat (Gia), so copy the same values. Leave the key empty to switch it off.
OPENAI_API_KEY=""
# Optional. If empty it uses gpt-5-nano, the cheapest current model; set the same model Gia uses, or gpt-4.1-mini, for fuller answers.
OPENAI_MODEL=""

# Plivo — the Telecalling stats page reads call records from Plivo's API (Auth ID and Auth Token are on the Plivo console home page).
# Leave empty to keep it off: the page then says Plivo isn't connected.
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
