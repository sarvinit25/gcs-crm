// Growth Capital Services — CRM data model.
// Pipeline: Lead -> Application -> Sanction -> Disbursement -> Commission.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Team & access ──────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  ADVISOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(ADVISOR)
  designation  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Set when an admin issues a password (new account, reset): the person must choose their own before doing anything else.
  mustChangePassword Boolean   @default(false)
  // Authenticator-app two-step login. The secret exists from setup; it only counts once totpEnabledAt is set.
  totpSecret         String?
  totpEnabledAt      DateTime?
  // Last 30-second step already accepted, so a code can't be used twice; and the one live sign-in challenge.
  totpLastStep       Int?
  totpChallengeJti   String?
  // Bumped when the password changes or is reset — every session issued before that stops working.
  tokenVersion       Int       @default(0)

  employeeCode      String?           @unique
  dateOfBirth       DateTime?         @db.Date
  joinedAt          DateTime?         @db.Date
  commissionPercent Decimal?          @db.Decimal(5, 2)
  reportsToId       String?
  reportsTo         User?             @relation("Reporting", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports           User[]            @relation("Reporting")
  managedPartners   SourcingPartner[] @relation("PartnerManager")

  // The one team this person works in, and the teams they lead. Drives lead routing.
  teamId             String?
  team               Team?     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  teamsLed           Team[]    @relation("TeamLead")
  // When auto-assignment last gave this person a lead, so the next one goes to whoever waited longest.
  lastLeadAssignedAt DateTime?

  leadsAsOfficer   Lead[]              @relation("LeadOfficer")
  leadsAsManager   Lead[]              @relation("LeadManager")
  applications     Application[]       @relation("ApplicationOwner")
  documents        Document[]
  attendance       Attendance[]
  payroll          PayrollRecord[]
  commissionSplits CommissionSplit[]
  followUps        FollowUp[]
  invitesCreated   ApplicationInvite[]
  marketingSpends  MarketingSpend[]
  creditChecks     CreditCheck[]

  @@index([role, active])
}

// ─── Teams ──────────────────────────────────────────────────

/**
 * A group of staff with a lead. Auto-assignment hands new leads out among team members, and routes partner leads to the lead.
 */
model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  leadId      String?
  lead        User?    @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members     User[]   @relation("TeamMembers")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
}

// ─── Audit trail ────────────────────────────────────────────

enum AuditActorType {
  STAFF
  PARTNER
  CLIENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

/**
 * Append-only record of who changed what. Money-bearing fields (sanctioned
 * amounts, rates, disbursements, commissions) and status moves are recorded so
 * a figure can always be traced back to a person and a time.
 */
model AuditLog {
  id String @id @default(cuid())

  // Actor name is denormalised so history stays readable if the staff record
  // is later deactivated or renamed. No FK: actorId can point into User,
  // SourcingPartner, or (later) a client table, so actorType disambiguates
  // which one instead of three nullable relations.
  actorId   String?
  actorType AuditActorType @default(STAFF)
  actorName String

  action      AuditAction
  entity      String
  entityId    String
  /**
   * Human-facing reference, e.g. GCS-2026-0042 or a lead's name.
   */
  entityLabel String?

  /**
   * Field-level diff: { field: { from, to } }.
   */
  changes Json?
  ip      String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId])
}

// ─── Master data (Settings + Lender Directory) ──────────────

enum LenderType {
  BANK
  NBFC
}

model Lender {
  id        String     @id @default(cuid())
  name      String     @unique
  type      LenderType
  logoUrl   String?
  // Lenders flagged public feed the website's partner directory.
  isPublic  Boolean    @default(true)
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  // How the lender is addressed day to day, and the terms GCS works with it on.
  shortName         String?
  brokerCode        String?
  // Payout GCS usually gets from this lender, as a percentage of the disbursed amount.
  defaultCommission Decimal? @db.Decimal(5, 2)
  portalUrl         String?
  branchName        String?
  branchCity        String?
  branchAddress     String?
  notes             String?

  applications Application[]
  contacts     LenderContact[]
  policies     LenderPolicy[]

  @@index([active, isPublic])
}

/**
 * A person at a bank or NBFC — usually the relationship / sales manager who takes
 * our files for one or more loan types. Internal only; never exposed publicly.
 */
model LenderContact {
  id          String   @id @default(cuid())
  lenderId    String
  lender      Lender   @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  phone       String?
  email       String?
  // Loan types this person handles, as named in Settings → Lender contact segments.
  segments    String[]
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lenderId])
}

model LoanProduct {
  id          String   @id @default(cuid())
  name        String   @unique
  // Matches the website's product URL, so enquiries land on the right product.
  slug        String   @unique
  code        String?  @unique
  category    String?
  description String?
  // Picture and colour chip shown for this loan type in the CRM.
  icon        String?
  color       String   @default("#6B7280")
  // Needs collateral (property, vehicle, securities) — shown as a badge, and a cue to collect property papers.
  secured     Boolean  @default(false)
  // Usual ticket size, used as a hint when a file is opened.
  minAmount   Decimal? @db.Decimal(14, 2)
  maxAmount   Decimal? @db.Decimal(14, 2)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  leads          Lead[]
  applications   Application[]
  documentTypes  DocumentType[]
  lenderPolicies LenderPolicy[]
}

model SourcingPartner {
  id             String   @id @default(cuid())
  // Human-facing reference, e.g. GCS-BSA-001.
  code           String?  @unique
  name           String
  firm           String?
  phone          String   @unique
  email          String?
  city           String?
  address        String?
  state          String?
  pincode        String?
  pan            String?
  gstin          String?
  // Where their commission is paid. Shown in full only to staff who can manage partners; masked in the audit log.
  bankName       String?
  accountNumber  String?
  ifsc           String?
  accountHolder  String?
  notes          String?
  commissionRate Decimal  @db.Decimal(5, 2)
  // Null until an admin sets one — a partner created before the portal
  // existed, or one not yet given access, simply can't sign in.
  passwordHash   String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  tokenVersion   Int      @default(0)

  // The staff member who looks after this partner.
  managerId String?
  manager   User?   @relation("PartnerManager", fields: [managerId], references: [id], onDelete: SetNull)

  leads            Lead[]
  commissionSplits CommissionSplit[]
}

/**
 * The published rate card shown to partners — per loan-product commission
 * range and typical earning, independent of any one partner's own negotiated
 * commissionRate above. Admin-managed; read by the partner portal and the
 * public website.
 */
model CommissionRateCard {
  id             String   @id @default(cuid())
  label          String
  minRate        Decimal  @db.Decimal(5, 2)
  maxRate        Decimal  @db.Decimal(5, 2)
  avgAmountLabel String
  earningLabel   String
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Leads ──────────────────────────────────────────────────

// How a lead is worked, in priority order (the order here is the order they sort in):
// HOT = details and documents complete, ready for a meeting; WARM = good potential but
// something is missing; FOLLOW_UP = interested, will decide later; COLD = nothing to go on yet.
enum LeadSegment {
  HOT
  WARM
  FOLLOW_UP
  COLD
}

// Documents the customer has handed over so far (documents proper attach to an application,
// which only exists once a lead is converted, so for a lead the team records it here).
enum DocumentsStatus {
  NONE
  PARTIAL
  COMPLETE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DOCS_PENDING
  CONVERTED
  LOST
}

model Lead {
  id     String  @id @default(cuid())
  leadNo Int     @unique @default(autoincrement())
  name   String
  phone  String
  email  String?
  city   String?

  loanProductId String?
  loanProduct   LoanProduct? @relation(fields: [loanProductId], references: [id])
  amount        Decimal?     @db.Decimal(14, 2)

  // Free-text so website forms, WhatsApp and the AI telecaller can all tag themselves.
  source            String
  sourcingPartnerId String?
  sourcingPartner   SourcingPartner? @relation(fields: [sourcingPartnerId], references: [id])

  assignedOfficerId String?
  assignedOfficer   User?   @relation("LeadOfficer", fields: [assignedOfficerId], references: [id])
  assignedManagerId String?
  assignedManager   User?   @relation("LeadManager", fields: [assignedManagerId], references: [id])

  status         LeadStatus @default(NEW)
  nextFollowUpAt DateTime?
  notes          String?

  // Why a lead was closed out — set when status becomes LOST, cleared if it is reopened.
  lostReason      String?
  // Closed files are archived, never deleted: hidden from working lists, still searchable and in reports.
  archivedAt      DateTime?
  employmentType  EmploymentType?
  monthlyIncome   Decimal?        @db.Decimal(14, 2)
  // What a lender asks before a meeting. All optional, and they carry over to the applicant when the lead becomes a file.
  secondaryPhone  String?
  dateOfBirth     DateTime?       @db.Date
  pan             String?
  address         String?
  pincode         String?
  employerName    String?
  designation     String?
  experienceYears Decimal?        @db.Decimal(4, 1)
  workLocation    String?
  officialEmail   String?
  meetingMode     String?
  meetingPlace    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Priority segment. Worked out automatically from the lead's details, documents and follow-up
  // date (see leads/lead-segment.ts) unless staff pin it (segmentLocked). Null once a lead is closed.
  documentsStatus DocumentsStatus @default(NONE)
  segment         LeadSegment?
  segmentLocked   Boolean         @default(false)
  segmentNote     String?

  // Where the lead came from, for marketing reports: the channel (Google Search Ads,
  // Society activation, Referral …), the campaign, and the raw tracking tags the website passed along.
  channel     String?
  campaign    String?
  utmSource   String?
  utmMedium   String?
  utmContent  String?
  utmTerm     String?
  landingPage String?

  // Set when this person proved they own the number with a one-time code in the website chat.
  // Those leads are the "Chatbot contacts" in the CRM.
  chatVerifiedAt DateTime?

  application Application?
  followUps   FollowUp[]
  submissions WebsiteSubmission[]

  @@index([chatVerifiedAt])
  @@index([status, nextFollowUpAt])
  @@index([segment, nextFollowUpAt])
  @@index([assignedOfficerId])
  @@index([phone])
  @@index([createdAt])
  @@index([loanProductId])
  @@index([sourcingPartnerId])
  @@index([channel, createdAt])
  @@index([archivedAt])
}

// ─── Lead sources ───────────────────────────────────────────

/**
 * Where leads come from (Walk-in, Website, Referral, Google Search Ads …), kept as a table so the admin can add,
 * rename, colour, reorder and switch them off. A lead stores the source's name in Lead.channel, so renaming one
 * here does not rewrite old leads; switching it off just stops it being offered.
 */
model LeadSource {
  id          String   @id @default(cuid())
  name        String   @unique
  // A short upper-case tag such as WALKIN or REF, for reports and imports.
  code        String?  @unique
  description String?
  // The name of an icon from the CRM's own set (see frontend/src/lib/lead-source-icons.ts).
  icon        String?
  color       String   @default("#6B7280")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

// ─── Website chat sign-in ───────────────────────────────────

// A one-time code sent to a visitor's mobile before the website chat opens. Only a hash of the
// code is kept. A code is good for a few minutes and a handful of tries, then it is dead.
model ChatOtp {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  name      String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

// Off-topic messages counted against a verified mobile number, so signing in again does not wipe them.
// A few in a row pause the chat for that number for a while.
model ChatStrike {
  phone        String    @id
  strikes      Int       @default(0)
  lastStrikeAt DateTime?
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

// A verified visitor's chat pass. The browser holds the token; only its hash is stored here.
model ChatSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  phone     String
  name      String
  leadId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

// A one-time code sent to a mobile number so a client or partner can be sent their GCS ID. Like ChatOtp, only a
// hash of the code is kept, and it is good for a few minutes and a handful of tries.
model IdRecoveryOtp {
  id        String    @id @default(cuid())
  phone     String
  // "client" or "partner": which kind of GCS ID the person asked for.
  kind      String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model FollowUp {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  note      String
  dueAt     DateTime?
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([leadId])
}

// ─── Applications ───────────────────────────────────────────

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  BANK_LOGIN
  UNDER_REVIEW
  SANCTIONED
  DISBURSED
  REJECTED
  WITHDRAWN
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  PROFESSIONAL
  BUSINESS
  OTHER
}

// Only meaningful when employmentType is SELF_EMPLOYED or BUSINESS — how the
// business is constituted, which is what actually drives which business-proof
// documents a lender asks for (Shop Act vs Partnership Deed vs MOA/AOA...).
enum ApplicantConstitution {
  PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  LLP
  OTHER
}

model Application {
  id  String @id @default(cuid())
  // Drives the human-facing reference (GCS-2026-0042), formatted on read.
  // A sequence rather than a built string, so concurrent creates can't collide.
  seq Int    @unique @default(autoincrement())

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id])

  loanProductId String
  loanProduct   LoanProduct @relation(fields: [loanProductId], references: [id])

  lenderId String?
  lender   Lender? @relation(fields: [lenderId], references: [id])

  ownerId String?
  owner   User?   @relation("ApplicationOwner", fields: [ownerId], references: [id])

  requestedAmount Decimal   @db.Decimal(14, 2)
  tenureMonths    Int?
  purpose         String?
  bankLoginAt     DateTime?
  // The bank's own reference for this file, once logged in — distinct from
  // our applicationNo.
  bankReferenceNo String?
  // Who at the bank is handling it, and what it cost to log in — and which
  // channel/DSA the file was routed through, when it's not a direct login.
  bankerName      String?
  bankerMobile    String?
  loginFees       Decimal?  @db.Decimal(12, 2)
  dsaChannel      String?

  // Shared secret (with the primary applicant's phone) for the borrower
  // portal login — never the same value as the human-facing applicationNo,
  // which is sequential and guessable.
  portalAccessCode   String? @unique
  // Bumped when the access code is regenerated, which ends any borrower session already open.
  portalTokenVersion Int     @default(0)

  status     ApplicationStatus @default(DRAFT)
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  applicants          Applicant[]
  references          Reference[]
  documents           Document[]
  sanction            Sanction?
  disbursements       Disbursement[]
  statementScans      BankStatementAnalysis[]
  educationLoanDetail EducationLoanDetail?
  invites             ApplicationInvite[]
  existingLoans       ExistingLoan[]
  creditEvaluation    CreditEvaluation?

  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
  @@index([loanProductId])
  @@index([lenderId])
  @@index([bankLoginAt])
  @@index([archivedAt])
}

model Applicant {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // First applicant per application is the primary; the rest are co-applicants.
  isPrimary      Boolean                @default(false)
  name           String
  relation       String?
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  pan            String?
  aadhaarLast4   String?
  address        String?
  city           String?
  pincode        String?
  employmentType EmploymentType?
  constitution   ApplicantConstitution?
  isNRI          Boolean                @default(false)
  employerName   String?
  monthlyIncome  Decimal?               @db.Decimal(14, 2)
  cibilScore     Int?
  // The date of the report that score came from, when known.
  cibilScoreDate DateTime?              @db.Date
  creditChecks   CreditCheck[]

  @@index([applicationId])
}

model Reference {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  relation      String?
  address       String?

  @@index([applicationId])
}

// ─── Documents (stored in Backblaze B2, only keys held here) ─

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  category     String
  fileName     String
  objectKey    String             @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id])
  // Set when the customer uploaded it themselves through their application-form link.
  inviteId     String?
  invite       ApplicationInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  @@index([applicationId])
  @@index([inviteId])
}

// ─── Sanctions ──────────────────────────────────────────────

enum SanctionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Sanction {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Technical and financial sanction move independently and are tracked separately.
  technicalStatus SanctionStatus @default(PENDING)
  technicalAt     DateTime?
  technicalNote   String?

  financialStatus SanctionStatus @default(PENDING)
  financialAt     DateTime?
  financialNote   String?

  // A third, independent leg — the legal team's title/document review.
  legalStatus SanctionStatus @default(PENDING)
  legalAt     DateTime?
  legalNote   String?

  sanctionedAmount Decimal?  @db.Decimal(14, 2)
  interestRate     Decimal?  @db.Decimal(5, 2)
  tenureMonths     Int?
  sanctionLetterNo String?
  validTill        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// ─── Disbursements ──────────────────────────────────────────

enum DisbursementType {
  FULL
  PART
}

enum RoiType {
  FIXED
  FLOATING
}

model Disbursement {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type           DisbursementType @default(FULL)
  amount         Decimal          @db.Decimal(14, 2)
  disbursedAt    DateTime
  interestRate   Decimal?         @db.Decimal(5, 2)
  roiType        RoiType?
  loanAccountNo  String?
  // Sanctioned amount still undrawn after this payout.
  runningBalance Decimal?         @db.Decimal(14, 2)
  utrNo          String?

  // Deducted-at-disbursal charges — kept separate from `amount` (the net
  // payout) so the gross breakdown stays visible on the file.
  processingFee        Decimal? @db.Decimal(14, 2)
  insuranceAmount      Decimal? @db.Decimal(14, 2)
  documentationCharges Decimal? @db.Decimal(14, 2)
  stampDuty            Decimal? @db.Decimal(14, 2)

  note      String?
  createdAt DateTime @default(now())

  commission Commission?

  @@index([applicationId])
  @@index([disbursedAt])
}

// ─── Commissions ────────────────────────────────────────────

enum PayoutStatus {
  PENDING
  PARTIAL
  PAID
}

model Commission {
  id             String       @id @default(cuid())
  disbursementId String       @unique
  disbursement   Disbursement @relation(fields: [disbursementId], references: [id], onDelete: Cascade)

  // What the lender pays GCS on this disbursement.
  grossRate   Decimal      @db.Decimal(5, 2)
  grossAmount Decimal      @db.Decimal(14, 2)
  status      PayoutStatus @default(PENDING)
  receivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  splits CommissionSplit[]

  @@index([createdAt])
}

// One row per stakeholder taking a cut of a commission — staff or sourcing partner.
model CommissionSplit {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  userId            String?
  user              User?            @relation(fields: [userId], references: [id])
  sourcingPartnerId String?
  sourcingPartner   SourcingPartner? @relation(fields: [sourcingPartnerId], references: [id])

  // Free-text tag for why this stakeholder gets a cut on this deal specifically
  // (e.g. "Lead Creator", "RO", "Sales Manager") — distinct from their
  // permanent staff Role, and organisation-specific enough not to be an enum.
  stakeholderRole String?

  sharePercent Decimal      @db.Decimal(5, 2)
  amount       Decimal      @db.Decimal(14, 2)
  status       PayoutStatus @default(PENDING)
  paidAt       DateTime?

  @@index([commissionId])
}

// ─── Attendance & Payroll ───────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
  HOLIDAY
}

model Attendance {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  note       String?
  checkInAt  DateTime?
  checkOutAt DateTime?

  @@unique([userId, date])
  @@index([date])
}

model PayrollRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  month      Int
  year       Int
  baseSalary Decimal      @db.Decimal(12, 2)
  incentives Decimal      @default(0) @db.Decimal(12, 2)
  deductions Decimal      @default(0) @db.Decimal(12, 2)
  netPay     Decimal      @db.Decimal(12, 2)
  status     PayoutStatus @default(PENDING)
  paidAt     DateTime?

  @@unique([userId, month, year])
}

// ─── Bank Statement Analyzer (optional add-on) ──────────────

model BankStatementAnalysis {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  documentId     String?
  averageBalance Decimal?  @db.Decimal(14, 2)
  totalCredits   Decimal?  @db.Decimal(14, 2)
  totalDebits    Decimal?  @db.Decimal(14, 2)
  salaryCredits  Json?
  bounceCount    Int       @default(0)
  periodFrom     DateTime?
  periodTo       DateTime?
  // Flagged when parsed from a scan, so the RO double-checks before relying on it.
  needsReview    Boolean   @default(true)
  raw            Json?
  createdAt      DateTime  @default(now())

  @@index([applicationId])
}

// ─── Document checklist ─────────────────────────────────────

// The applicant-profile branch a checklist item applies to. Distinct from
// EmploymentType/ApplicantConstitution on Applicant — this is what a
// ChecklistItem is tagged with; the checklist service resolves which bucket
// an applicant falls into (NRI overrides everything else, then employment
// type, then business constitution) and matches items against it.
enum ChecklistApplicantType {
  SALARIED
  PROFESSIONAL
  PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  LLP
  NRI
}

/**
 * Master list of the documents a case can need — not per-application state.
 * No loan types selected means it applies to every loan type; no applicant
 * profiles selected means it applies whatever the primary applicant's profile
 * (e.g. PAN card). The application-level checklist resolves the applicable
 * rows and cross-checks them against uploaded Documents by category to show
 * Given/Pending, so `category` must be one of the upload categories.
 */
model DocumentType {
  id             String                   @id @default(cuid())
  name           String
  code           String?                  @unique
  // The upload category a received document is filed under.
  category       String
  // What to ask the customer for, e.g. "Last 6 months, PDF from net banking".
  description    String?
  loanProducts   LoanProduct[]
  applicantTypes ChecklistApplicantType[]
  sortOrder      Int                      @default(0)
  active         Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([name, category])
}

// ─── Credit evaluation ──────────────────────────────────────

enum CreditDecision {
  READY
  REJECTED
}

/**
 * A loan or card the applicant already pays on, counted against income when working out what they can afford.
 */
model ExistingLoan {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Whose it is; blank means the household.
  applicantId   String?
  lenderName    String
  loanType      String?
  outstanding   Decimal?    @db.Decimal(14, 2)
  emi           Decimal     @db.Decimal(14, 2)
  monthsLeft    Int?
  // Off when the loan will be closed before the new one is logged in, so its EMI is not counted.
  counted       Boolean     @default(true)
  note          String?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

/**
 * The inputs and the outcome of assessing one file: what the numbers need beyond what is already on it,
 * and whether it was cleared for login or turned away. The results themselves are worked out on read.
 */
model CreditEvaluation {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  loanAmount            Decimal? @db.Decimal(14, 2)
  proposedRate          Decimal? @db.Decimal(5, 2)
  tenureMonths          Int?
  monthlyIncome         Decimal? @db.Decimal(14, 2)
  annualTurnover        Decimal? @db.Decimal(14, 2)
  netProfit             Decimal? @db.Decimal(14, 2)
  depreciation          Decimal? @db.Decimal(14, 2)
  interestPaid          Decimal? @db.Decimal(14, 2)
  avgMonthlyBankCredits Decimal? @db.Decimal(14, 2)
  gstAnnualTurnover     Decimal? @db.Decimal(14, 2)
  propertyValue         Decimal? @db.Decimal(14, 2)
  remarks               String?

  decision      CreditDecision?
  decisionNote  String?
  decidedAt     DateTime?
  decidedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Education Loan case intake ─────────────────────────────

/**
 * Education Loan's own intake sheet — family and course details that don't
 * fit any other loan product and aren't worth adding narrow columns for
 * everywhere else. `details` is validated at the API boundary
 * (EducationLoanDetailsDto) even though it's stored as one JSON blob, the
 * same way BankStatementAnalysis.raw holds a validated shape.
 */
model EducationLoanDetail {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  details Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Failed-attempt counter per sign-in subject (an email, a phone number, a user),
 * so guessing is capped per account and not just per IP address.
 */
model LoginLock {
  subject     String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/**
 * A link a customer opens (no login) to fill in their own application form and
 * upload documents. The link itself is never stored in the clear: only its hash
 * is used for lookup, and an encrypted copy lets staff copy it again later.
 */
model ApplicationInvite {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  tokenEnc  String

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  expiresAt   DateTime
  revokedAt   DateTime?
  openedAt    DateTime?
  lastSavedAt DateTime?
  submittedAt DateTime?
  // What the customer has typed so far; applied to the real records only when they submit.
  draft       Json?
  createdAt   DateTime  @default(now())

  documents Document[]

  @@index([applicationId, createdAt])
}

/**
 * What was spent on marketing, entered by hand (or from an agency's report) so cost per lead and
 * cost per customer can be worked out. One row per spend; the channel matches Lead.channel.
 */
model MarketingSpend {
  id          String   @id @default(cuid())
  spentOn     DateTime @db.Date
  channel     String
  campaign    String?
  // Agency or vendor it was paid through, e.g. an advertising agency.
  vendor      String?
  amount      Decimal  @db.Decimal(14, 2)
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([spentOn])
  @@index([channel, spentOn])
}

enum CreditCheckKind {
  // Pulled from the bureau through the configured provider.
  LIVE
  // A score typed in from a report obtained elsewhere (the lender's, or the customer's own).
  MANUAL
  // Produced by the built-in test provider. Never real, never changes the applicant's score.
  SIMULATED
}

enum CreditCheckStatus {
  SUCCESS
  FAILED
}

/**
 * One credit-bureau check on one applicant: what was asked, the consent it was asked under,
 * who asked, and what came back. Kept as history; the applicant row only holds the latest real score.
 */
model CreditCheck {
  id          String            @id @default(cuid())
  applicantId String
  applicant   Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  bureau      String            @default("CIBIL")
  kind        CreditCheckKind
  status      CreditCheckStatus
  score       Int?
  reportDate  DateTime?         @db.Date
  // The bureau's own reference for the report, or the number on the paper one.
  reference   String?
  note        String?
  error       String?

  // Credit reports may only be pulled with the person's consent; how it was given is kept with the pull.
  consentAt     DateTime?
  consentMethod String?
  consentText   String?

  requestedById String?
  requestedBy   User?    @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([applicantId, createdAt])
  @@index([createdAt])
}

/// What happened to a form entry that arrived from the public website (or WhatsApp / telecaller).
enum SubmissionOutcome {
  /// Nobody with this phone and name was open, so it became a new lead.
  NEW_LEAD
  /// The same person was already open and their lead had at least as many entries: this one is only logged.
  DUPLICATE_KEPT
  /// The same person was already open but this entry was fuller: it filled in / replaced the lead's details.
  DUPLICATE_UPDATED
}

/**
 * Every entry that came in through the public intake, kept as received. The lead is the
 * de-duplicated person; this is the inbox of what actually arrived, so nothing is lost
 * when two entries are merged into one lead.
 */
model WebsiteSubmission {
  id         String   @id @default(cuid())
  receivedAt DateTime @default(now())

  /// Which form it came from ("ca-legal-enquiry", "checklist-download" …).
  form String

  name        String
  phone       String
  email       String?
  city        String?
  loanType    String?
  amount      Decimal? @db.Decimal(14, 2)
  detail      String?
  landingPage String?
  /// How many of name, phone, email, city, loan type, amount and detail were filled in.
  entries     Int

  outcome     SubmissionOutcome
  /// Same phone as an open lead but a different name: kept as its own lead, flagged for a look.
  sharedPhone Boolean           @default(false)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@index([form, receivedAt])
  @@index([outcome, receivedAt])
  @@index([phone])
  @@index([leadId])
}

/**
 * The pop-up poster the public website shows (e.g. a Diwali offer). Staff upload the image and
 * choose the dates it runs; the website asks for the one that is live today.
 */
model WebsiteAd {
  id String @id @default(cuid())

  /// Internal name, also the image's alt text on the website.
  title     String
  imageKey  String
  imageMime String
  imageSize Int
  /// Optional https link a click on the poster opens.
  linkUrl   String?

  /// First and last moment it runs: start of the first day and end of the last day, India time.
  startsAt DateTime
  endsAt   DateTime
  /// Switches it off without deleting it or changing the dates.
  paused   Boolean  @default(false)

  createdById   String?
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startsAt, endsAt])
}

// ─── Downloadable checklist PDFs published on the website ───

/**
 * One checklist PDF the public website offers for download. Staff manage the list in Settings.
 */
model ChecklistDocument {
  id          String   @id @default(cuid())
  title       String
  // Website product/service slug this checklist belongs to, e.g. "home-loan".
  productSlug String?
  // Variant within a product, e.g. "Salaried", "NRI".
  variant     String?
  // Where the PDF is served from — a website path (/checklists/x.pdf) or a full URL.
  fileUrl     String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productSlug])
}

// ─── Website content staff edit from the CRM ───

/**
 * Text content shown on the public website, one row per section (faqs, products, caseStudies).
 * A missing row means the website uses the copy built into it.
 */
model SiteContent {
  key           String   @id
  value         Json
  updatedAt     DateTime @updatedAt
  updatedByName String?
}

/**
 * Every save or reset of a website content section, so a mistake can be undone.
 */
model SiteContentVersion {
  id          String   @id @default(cuid())
  key         String
  // The section as saved; null when the section was reset to the website's built-in copy.
  value       Json?
  savedAt     DateTime @default(now())
  savedByName String?

  @@index([key, savedAt])
}

/**
 * A picture staff uploaded to replace one on the public website. Small, so kept in the database.
 */
model SiteImage {
  id            String   @id @default(cuid())
  name          String
  mime          String
  data          Bytes
  createdAt     DateTime @default(now())
  createdByName String?
}

// ─── Lender policy database ──────────────────────────────────────────────────
// One record per lender + loan product: the rules GCS keeps about what that lender will do, with
// where the rule came from and when someone last checked it. The matcher only trusts a record that
// is active, in date and recently verified; anything else goes to a human instead.
model LenderPolicy {
  id            String      @id @default(cuid())
  lenderId      String
  lender        Lender      @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  loanProductId String
  loanProduct   LoanProduct @relation(fields: [loanProductId], references: [id], onDelete: Cascade)

  active          Boolean   @default(true)
  version         Int       @default(1)
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  // Where the rules came from (policy circular, RM email …) and who last confirmed them.
  source          String?
  lastVerifiedAt  DateTime?
  verifiedById    String?
  verifiedByName  String?
  reviewEveryDays Int       @default(90)

  // What the lender offers
  minAmount         Decimal? @db.Decimal(14, 2)
  maxAmount         Decimal? @db.Decimal(14, 2)
  minRate           Decimal? @db.Decimal(5, 2)
  maxRate           Decimal? @db.Decimal(5, 2)
  processingFee     String?
  minTenureMonths   Int?
  maxTenureMonths   Int?
  // FLOATING or FIXED.
  rateType          String?
  // Payout GCS gets from this lender on this loan type, as a percentage of the disbursed amount.
  commissionPercent Decimal? @db.Decimal(5, 2)
  specialScheme     String?

  // Who it is for
  employmentTypes          String[]
  minAge                   Int?
  maxAgeAtApplication      Int?
  maxAgeAtMaturity         Int?
  minMonthlyIncome         Decimal? @db.Decimal(14, 2)
  minBusinessVintageMonths Int?
  minAnnualTurnover        Decimal? @db.Decimal(14, 2)
  minAnnualProfit          Decimal? @db.Decimal(14, 2)
  minCreditScore           Int?
  acceptedConstitutions    String[]
  gstRequired              Boolean  @default(false)

  // Money rules. Each band is { upTo: number | null, value: number } in rupees / percent.
  foirBands             Json?
  ltvBands              Json?
  acceptedPropertyTypes String[]

  // Where it is available. Blank cities on a non-all-India policy means "not confirmed".
  allIndia Boolean  @default(false)
  cities   String[]

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changes    LenderPolicyChange[]
  exceptions PolicyException[]

  @@unique([lenderId, loanProductId])
  @@index([active, lastVerifiedAt])
}

/**
 * Every save of a policy keeps the version it replaced, so any past match can be explained.
 */
model LenderPolicyChange {
  id            String       @id @default(cuid())
  policyId      String
  policy        LenderPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  changedById   String?
  changedByName String?
  reason        String?
  createdAt     DateTime     @default(now())

  @@index([policyId, version])
}

/**
 * What experienced staff know that a rule sheet does not: when a lender bends a rule, and who must agree.
 */
model PolicyException {
  id                String       @id @default(cuid())
  policyId          String
  policy            LenderPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  scenario          String
  normalRule        String?
  possibleException String?
  requiredApproval  String?
  source            String?
  lastVerifiedAt    DateTime?
  expertNote        String?
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())

  @@index([policyId])
}

/**
 * One run of the matcher with the exact answers used and the result, kept for audit and review.
 */
model MatchRun {
  id             String    @id @default(cuid())
  leadId         String?
  profile        Json
  results        Json
  createdById    String?
  createdByName  String?
  reviewStatus   String    @default("PENDING")
  reviewedById   String?
  reviewedByName String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([leadId, createdAt])
}

/**
 * How each case ended, by lender and product, so GCS learns what really gets sanctioned.
 */
model CaseOutcome {
  id              String    @id @default(cuid())
  leadId          String?
  applicationId   String?
  lenderId        String?
  loanProductId   String?
  recommended     Boolean   @default(false)
  submittedAt     DateTime?
  outcome         String    @default("SUBMITTED")
  sanctionAmount  Decimal?  @db.Decimal(14, 2)
  rate            Decimal?  @db.Decimal(5, 2)
  turnaroundDays  Int?
  rejectionReason String?
  disbursed       Boolean   @default(false)
  profile         Json?
  notes           String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lenderId, loanProductId])
  @@index([leadId])
}
