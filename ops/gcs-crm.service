# /etc/systemd/system/gcs-crm.service — runs the API and restarts it if it ever stops.
[Unit]
Description=GCS CRM API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=gcs
WorkingDirectory=/opt/gcs-crm/backend
EnvironmentFile=/opt/gcs-crm/backend/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=3
# Hardening: the API needs no special privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
