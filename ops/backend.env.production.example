# Copy to /opt/gcs-crm/backend/.env on the server and fill in. Never commit the real file.
NODE_ENV=production
PORT=4000
API_PREFIX=/crm/api

# Postgres on this server (create a dedicated user; do not reuse the development password).
DATABASE_URL="postgresql://gcs_crm:CHOOSE-A-LONG-PASSWORD@localhost:5432/gcs_crm?schema=public"
ALLOW_LOCAL_DATABASE=true

# Generate with:  openssl rand -hex 48     (the app refuses to start with a short or placeholder secret)
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Encrypts two-step login secrets in the database. Generate with:  openssl rand -hex 32
# Keep a copy with your backups, apart from the database dump: if it is lost, every
# two-step login must be reset by a Super Admin. Never reuse the JWT secret.
SECRETS_ENCRYPTION_KEY=

# Nginx is the one proxy in front of the app.
TRUST_PROXY_HOPS=1
CORS_ORIGIN=https://growthcapitalservices.in

# Cloudflare Turnstile — protects the public lead form (required in production).
TURNSTILE_SECRET=

# OpenAI — powers the "Ask AI" assistant, answering from the CRM's own records scoped to the
# person asking (and the WhatsApp staff chat). OPENAI_MODEL is optional. Leave the key empty to keep it off.
OPENAI_API_KEY=
OPENAI_MODEL=

# WhatsApp (Meta Cloud API, called directly) — inbox, chatbot and automatic messages.
# Leave empty to keep it off: the WhatsApp pages then say it isn't connected.
# All five come from the Meta developer app; see docs/WHATSAPP.md. WHATSAPP_PROVIDER=sandbox
# is for local testing only and is ignored in production.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# AI phone agent (Sarvam) — end-of-call messages become leads. Leave empty to keep it off.
# At least 16 random characters. Sarvam's Webhook URL is
#   https://<site>/crm/api/public/voice/sarvam?key=<this value>
VOICE_WEBHOOK_SECRET=

# Backblaze B2 — where uploaded documents live (required in production).
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# Plivo — call records for the Telecalling page. Leave empty to keep it off.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
